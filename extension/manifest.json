{
  "manifest_version": 3,
  "name": "CallConsent — AI Notetaker Alert",
  "version": "0.1.0",
  "description": "Alerts you the moment an AI notetaker (Otter, Fireflies, Fathom, Read.ai, Grain, tl;dv, Gong, and more) joins your Google Meet or Zoom call, and shows the consent disclosure your state likely expects.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/state-data.js", "src/detectors/meet.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.zoom.us/wc/*", "https://*.zoom.us/j/*", "https://*.zoom.us/s/*"],
      "js": ["src/state-data.js", "src/detectors/zoom.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "CallConsent settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
